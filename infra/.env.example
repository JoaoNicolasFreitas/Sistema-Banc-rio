# Exemplo de variaveis de ambiente (copie para .env e ajuste valores seguros)
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=sistema_admin
DB_USER=sistema_user
DB_PASSWORD=change_me_db_password
DB_PORT=3306

SERVER_PORT=8080
FRONTEND_PORT=4200

# Chave secreta JWT em Base64 (minimo 256 bits / 32 bytes); gere uma chave propria
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Credenciais do usuario ADMIN inicial (usado apenas se nao houver ADMIN no banco)
ADMIN_BOOTSTRAP_NAME=Administrador do Sistema
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
